{
  "name": "side-panel",
  "productName": "Side",
  "version": "1.0.0",
  "description": "A macOS-first, Dock-adjacent chat panel for Pi-supported models.",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:dock-helper": "mkdir -p native && swiftc -O -framework AppKit -framework ApplicationServices src/main/dock-geometry.swift -o native/dock-geometry",
    "prestart": "pnpm run build:dock-helper",
    "start": "electron-forge start",
    "prepackage": "pnpm run build:dock-helper",
    "package": "electron-forge package",
    "premake": "pnpm run build:dock-helper",
    "make": "electron-forge make",
    "lint": "eslint --ext .ts,.tsx src forge.config.ts vite.*.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [],
  "author": {
    "name": "qyinm",
    "email": "qusseun@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "44.4.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@side/pi-agent": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
