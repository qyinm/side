{
  "name": "side-panel",
  "productName": "Side",
  "version": "1.0.3",
  "description": "A macOS-first, Dock-adjacent chat panel for Pi-supported models.",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:dock-helper": "mkdir -p native && swiftc -O -framework AppKit -framework ApplicationServices src/main/dock-geometry.swift -o native/dock-geometry",
    "prestart": "bun run build:dock-helper",
    "start": "electron-forge start",
    "prepackage": "bun run build:dock-helper",
    "package": "electron-forge package",
    "premake": "bun run build:dock-helper && swift scripts/create-dmg-background.swift",
    "make": "electron-forge make",
    "lint": "eslint --ext .ts,.tsx,.mts src forge.config.ts vite.*.config.*",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [],
  "author": {
    "name": "qyinm",
    "email": "qusseun@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.4.3",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@side/pi-agent": "workspace:*",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^7.0.108",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "^2.6.0",
    "update-electron-app": "^3.3.0",
    "use-stick-to-bottom": "^1.1.6"
  }
}
