{
  "name": "side",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "check:oauth-bundle": "bun app/desktop/scripts/check-oauth-bundle.mjs",
    "landing:dev": "bun run --filter side-landing dev",
    "landing:build": "bun run --filter side-landing build",
    "landing:preview": "bun run --filter side-landing preview",
    "landing:deploy": "bun run --filter side-landing deploy",
    "start": "bun run --filter side-panel start",
    "package": "bun run --filter side-panel package",
    "make": "bun run --filter side-panel make",
    "release:mac": "bun app/desktop/scripts/release-mac.mjs",
    "lint": "bun run --filter side-panel lint",
    "typecheck": "bun run --filter side-panel typecheck"
  },
  "workspaces": [
    "app/landing",
    "app/desktop",
    "packages/pi-agent"
  ],
  "overrides": {
    "@electron/rebuild>@electron/node-gyp": "10.2.0-electron.2"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "fs-xattr",
    "macos-alias"
  ]
}
